# Public app config (optional)
NEXT_PUBLIC_APP_NAME=Wild Stories TV
NEXT_PUBLIC_API_URL=

# AI providers
# Required for Gemini-backed generation flows.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional unless Anthropic-backed flows are enabled.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Vercel Blob Storage
# Required for blob-backed preset and media flows.
BLOB_READ_WRITE_TOKEN=

# Preset Library Auth
# Required in production. Do not reuse the blob token here.
PRESET_LIBRARY_AUTH_SECRET=
