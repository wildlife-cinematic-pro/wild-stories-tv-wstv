# Public app config (optional)
NEXT_PUBLIC_APP_NAME=Wild Stories TV
NEXT_PUBLIC_API_URL=

# AI providers
# Gemini is the default provider.
# OpenAI and Claude are optional paid providers.
# Missing Gemini/OpenAI keys should skip polish and use base local output.
# API keys must stay server-side only.
# Required for Gemini-backed generation flows.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional unless OpenAI-backed polish flows are enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional unless Anthropic-backed flows are enabled.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# Vercel Blob Storage
# Required for blob-backed preset and media flows.
BLOB_READ_WRITE_TOKEN=

# Preset Library Auth
# Required in production. Do not reuse the blob token here.
PRESET_LIBRARY_AUTH_SECRET=
